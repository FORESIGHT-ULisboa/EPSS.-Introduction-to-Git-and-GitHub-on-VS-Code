# Identity of ONE tutorial member, for playing members A, B and C on one PC.
# Copy to ".env" in the member's folder (the clone, or the folder that contains it), fill in,
# then run:  setup_member.ps1 <clone folder>
# Never commit a filled-in .env. Students do not use this file at all.

MEMBER=B
GIT_USER_NAME=Name shown on this member's commits
GIT_USER_EMAIL=an-email-registered-in-that-github-account@example.org

# GitHub account that pushes from this clone. Leave both empty for member A if that is you:
# your normal sign-in is then used.
GITHUB_USER=
# Classic personal access token of that account with ONLY the "public_repo" scope
# (github.com > Settings > Developer settings > Personal access tokens > Tokens (classic)).
# Fine-grained tokens do not work on another person's repository. Short expiry; delete it after recording.
GITHUB_TOKEN=
